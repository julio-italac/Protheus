	''																		, ; //X3_CHKSQL
	'N'																		, ; //X3_IDXSRV
	'N'																		, ; //X3_ORTOGRA
	''																		, ; //X3_TELA
	'1'																		, ; //X3_POSLGT
	'N'																		, ; //X3_IDXFLD
	'001'																	, ; //X3_AGRUP
	'1'																		, ; //X3_MODAL
	'S'																		} ) //X3_PYME

aAdd( aSX3, { ;
	'SBM'																	, ; //X3_ARQUIVO
	'03'																	, ; //X3_ORDEM
	'BM_DESC'																, ; //X3_CAMPO
	'C'																		, ; //X3_TIPO
	30																		, ; //X3_TAMANHO
	0																		, ; //X3_DECIMAL
	'Desc Grupo'															, ; //X3_TITULO
	'Desc. Grupo'															, ; //X3_TITSPA
	'Group Descr.'															, ; //X3_TITENG
	'Descricao do Grupo'													, ; //X3_DESCRIC
	'Descripcion del Grupo'													, ; //X3_DESCSPA
	'Group Description'														, ; //X3_DESCENG
	'@S30'																	, ; //X3_PICTURE
	'NaoVazio()'															, ; //X3_VALID
	Chr(128) + Chr(128) + Chr(128) + Chr(128) + Chr(128) + ;
	Chr(128) + Chr(128) + Chr(128) + Chr(128) + Chr(128) + ;
	Chr(128) + Chr(128) + Chr(128) + Chr(128) + Chr(160)					, ; //X3_USADO
	''																		, ; //X3_RELACAO
	''																		, ; //X3_F3
	1																		, ; //X3_NIVEL
	Chr(154) + Chr(192)														, ; //X3_RESERV
	''																		, ; //X3_CHECK
	''																		, ; //X3_TRIGGER
	''																		, ; //X3_PROPRI
	'S'																		, ; //X3_BROWSE
