	'S'																		} ) //X3_PYME

aAdd( aSX3, { ;
	'SE2'																	, ; //X3_ARQUIVO
	'O2'																	, ; //X3_ORDEM
	'E2_I_DGB'																, ; //X3_CAMPO
	'N'																		, ; //X3_TIPO
	10																		, ; //X3_TAMANHO
	2																		, ; //X3_DECIMAL
	'Desc. GB'																, ; //X3_TITULO
	'Desc. GB'																, ; //X3_TITSPA
