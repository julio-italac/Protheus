	'N'																		, ; //X3_IDXFLD
	''																		, ; //X3_AGRUP
	''																		, ; //X3_MODAL
	'S'																		} ) //X3_PYME

aAdd( aSX3, { ;
	'SE2'																	, ; //X3_ARQUIVO
	'O3'																	, ; //X3_ORDEM
	'E2_L_AGENC'															, ; //X3_CAMPO
	'C'																		, ; //X3_TIPO
	5																		, ; //X3_TAMANHO
	0																		, ; //X3_DECIMAL
	'Agencia Forn'															, ; //X3_TITULO
