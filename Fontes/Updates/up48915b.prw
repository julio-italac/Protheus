PutSX1Help( "PZBV_CHVNFE", aHlpPor, {}, {}, .T.,,.T. )
AutoGrLog( "Atualizado o Help do campo " + "ZBV_CHVNFE" )

aHlpPor := {}
aAdd( aHlpPor, 'Data Emissão NFE' )

PutSX1Help( "PZBV_DTEMIS", aHlpPor, {}, {}, .T.,,.T. )
AutoGrLog( "Atualizado o Help do campo " + "ZBV_DTEMIS" )

aHlpPor := {}
aAdd( aHlpPor, 'Codigo do Produtor' )

PutSX1Help( "PZBV_CODPRO", aHlpPor, {}, {}, .T.,,.T. )
AutoGrLog( "Atualizado o Help do campo " + "ZBV_CODPRO" )

aHlpPor := {}
