PutSX1Help( "PZBV_LOJPRO", aHlpPor, {}, {}, .T.,,.T. )
AutoGrLog( "Atualizado o Help do campo " + "ZBV_LOJPRO" )

aHlpPor := {}
aAdd( aHlpPor, 'Nome do Produtor' )

PutSX1Help( "PZBV_NOMPRO", aHlpPor, {}, {}, .T.,,.T. )
AutoGrLog( "Atualizado o Help do campo " + "ZBV_NOMPRO" )

aHlpPor := {}
aAdd( aHlpPor, 'Pdf NFE em ENCODE 64' )

PutSX1Help( "PZBV_PDFNFE", aHlpPor, {}, {}, .T.,,.T. )
AutoGrLog( "Atualizado o Help do campo " + "ZBV_PDFNFE" )

aHlpPor := {}
aAdd( aHlpPor, 'XML da Nota Fiscal ENCODE 64' )

PutSX1Help( "PZBV_XMLNFE", aHlpPor, {}, {}, .T.,,.T. )
AutoGrLog( "Atualizado o Help do campo " + "ZBV_XMLNFE" )

aHlpPor := {}
aAdd( aHlpPor, 'Json de Envio da NFE' )

PutSX1Help( "PZBV_JSONNF", aHlpPor, {}, {}, .T.,,.T. )
AutoGrLog( "Atualizado o Help do campo " + "ZBV_JSONNF" )

aHlpPor := {}
aAdd( aHlpPor, 'Data de Envio Nfe' )

PutSX1Help( "PZBV_DTENVN", aHlpPor, {}, {}, .T.,,.T. )
AutoGrLog( "Atualizado o Help do campo " + "ZBV_DTENVN" )

