	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'N'																		} ) //SHOWPESQ

aAdd( aSIX, { ;
	'ZBM'																	, ; //INDICE
	'2'																		, ; //ORDEM
	'ZBM_FILIAL+ZBM_IDCLIE+DTOS(ZBM_DTREC)'									, ; //CHAVE
	'Id.Cliente + Data Envio'												, ; //DESCRICAO
	'Id.Cliente + Data Envio'												, ; //DESCSPA
	'Id.Cliente + Data Envio'												, ; //DESCENG
	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'S'																		} ) //SHOWPESQ

aAdd( aSIX, { ;
	'ZBM'																	, ; //INDICE
	'3'																		, ; //ORDEM
	'ZBM_FILIAL+DTOS(ZBM_DTREC)+ZBM_HRREC+ZBM_CNPJ'							, ; //CHAVE
	'Data Recebim + Hora Recebim + CNPJ'									, ; //DESCRICAO
	'Data Recebim + Hora Recebim + CNPJ'									, ; //DESCSPA
	'Data Recebim + Hora Recebim + CNPJ'									, ; //DESCENG
	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'S'																		} ) //SHOWPESQ

aAdd( aSIX, { ;
	'ZBM'																	, ; //INDICE
	'4'																		, ; //ORDEM
	'ZBM_FILIAL+DTOS(ZBM_DTREC)+ZBM_HRREC+ZBM_IDCLIE'						, ; //CHAVE
	'Data Recebim + Hora Recebim + Id.Cliente'								, ; //DESCRICAO
	'Data Recebim + Hora Recebim + Id.Cliente'								, ; //DESCSPA
	'Data Recebim + Hora Recebim + Id.Cliente'								, ; //DESCENG
	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'S'																		} ) //SHOWPESQ

//
// Tabela ZBN
//
aAdd( aSIX, { ;
	'ZBN'																	, ; //INDICE
	'1'																		, ; //ORDEM
	'ZBN_FILIAL+ZBN_IDPEDV+ZBN_CNPJ+DTOS(ZBN_DTREC)'						, ; //CHAVE
	'Id.Pedido Vendas + CNPJ + Data Recebim'								, ; //DESCRICAO
	'Id.Pedido Vendas + CNPJ + Data Recebim'								, ; //DESCSPA
	'Id.Pedido Vendas + CNPJ + Data Recebim'								, ; //DESCENG
	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'S'																		} ) //SHOWPESQ

aAdd( aSIX, { ;
	'ZBN'																	, ; //INDICE
	'2'																		, ; //ORDEM
	'ZBN_FILIAL+ZBN_IDPEDV+ZBN_IDCLIE+DTOS(ZBN_DTREC)'						, ; //CHAVE
	'Id.Pedido Vendas + Id.Cliente + Data Recebim'							, ; //DESCRICAO
	'Id.Pedido Vendas + Id.Cliente + Data Recebim'							, ; //DESCSPA
	'Id.Pedido Vendas + Id.Cliente + Data Recebim'							, ; //DESCENG
	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'S'																		} ) //SHOWPESQ

aAdd( aSIX, { ;
	'ZBN'																	, ; //INDICE
	'3'																		, ; //ORDEM
	'ZBN_FILIAL+DTOS(ZBN_DTREC)+ZBN_HRREC+ZBN_IDPEDV+ZBN_CNPJ'				, ; //CHAVE
	'Data Recebim + Hora Recebim + Id. Pedido + Cnpj'						, ; //DESCRICAO
	'Data Recebim + Hora Recebim + Id. Pedido + Cnpj'						, ; //DESCSPA
	'Data Recebim + Hora Recebim + Id. Pedido + Cnpj'						, ; //DESCENG
	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'S'																		} ) //SHOWPESQ

aAdd( aSIX, { ;
	'ZBN'																	, ; //INDICE
	'4'																		, ; //ORDEM
	'ZBN_FILIAL+DTOS(ZBN_DTREC)+ZBN_HRREC+ZBN_IDPEDV+ZBN_IDCLIE'			, ; //CHAVE
	'Data Recebim + Hora Recebim + Id. Pedido + Id.Cliente'					, ; //DESCRICAO
	'Data Recebim + Hora Recebim + Id. Pedido + Id.Cliente'					, ; //DESCSPA
	'Data Recebim + Hora Recebim + Id. Pedido + Id.Cliente'					, ; //DESCENG
	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'S'																		} ) //SHOWPESQ

//
// Tabela ZBO
//
aAdd( aSIX, { ;
	'ZBO'																	, ; //INDICE
	'1'																		, ; //ORDEM
	'ZBO_FILIAL+ZBO_IDNFIS+ZBO_SITINT'										, ; //CHAVE
	'Id.Nota Fiscal + Situacao'												, ; //DESCRICAO
	'Id.Nota Fiscal + Situacao'												, ; //DESCSPA
	'Id.Nota Fiscal + Situacao'												, ; //DESCENG
	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'S'																		} ) //SHOWPESQ

aAdd( aSIX, { ;
	'ZBO'																	, ; //INDICE
	'2'																		, ; //ORDEM
	'ZBO_FILIAL+ZBO_IDNFIS+ZBO_IDPEDV+ZBO_SITINT'							, ; //CHAVE
	'Id.Nota Fiscal + Id.Pedido Vendas + Situacao'							, ; //DESCRICAO
	'Id.Nota Fiscal + Id.Pedido Vendas + Situacao'							, ; //DESCSPA
	'Id.Nota Fiscal + Id.Pedido Vendas + Situacao'							, ; //DESCENG
	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'S'																		} ) //SHOWPESQ

aAdd( aSIX, { ;
	'ZBO'																	, ; //INDICE
	'3'																		, ; //ORDEM
	'ZBO_FILIAL+ZBO_CHVNF+ZBO_IDFINA+ZBO_SITINT'							, ; //CHAVE
	'Chave Nota Fiscal + Id.Financeiro + Situacao'							, ; //DESCRICAO
	'Chave Nota Fiscal + Id.Financeiro + Situacao'							, ; //DESCSPA
	'Chave Nota Fiscal + Id.Financeiro + Situacao'							, ; //DESCENG
	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'S'																		} ) //SHOWPESQ

//
// Tabela ZBR
//
aAdd( aSIX, { ;
	'ZBR'																	, ; //INDICE
	'1'																		, ; //ORDEM
	'ZBR_FILIAL+ZBR_IDFINA+ZBR_SITINT'										, ; //CHAVE
	'Id.Financeiro + Situacao'												, ; //DESCRICAO
	'Id.Financeiro + Situacao'												, ; //DESCSPA
	'Id.Financeiro + Situacao'												, ; //DESCENG
	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'S'																		} ) //SHOWPESQ

aAdd( aSIX, { ;
	'ZBR'																	, ; //INDICE
	'2'																		, ; //ORDEM
	'ZBR_FILIAL+ZBR_IDPEDV+ZBR_SITINT'										, ; //CHAVE
	'Id.Pedido Vendas + Situacao'											, ; //DESCRICAO
	'Id.Pedido Vendas + Situacao'											, ; //DESCSPA
	'Id.Pedido Vendas + Situacao'											, ; //DESCENG
	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'S'																		} ) //SHOWPESQ

//
// Atualizando dicionário
//
oProcess:SetRegua2( Len( aSIX ) )

dbSelectArea( "SIX" )
SIX->( dbSetOrder( 1 ) )

For nI := 1 To Len( aSIX )

	lAlt    := .F.
	lDelInd := .F.

	If !SIX->( dbSeek( aSIX[nI][1] + aSIX[nI][2] ) )
		AutoGrLog( "Índice criado " + aSIX[nI][1] + "/" + aSIX[nI][2] + " - " + aSIX[nI][3] )
	Else
		lAlt := .T.
		aAdd( aArqUpd, aSIX[nI][1] )
		If !StrTran( Upper( AllTrim( CHAVE )       ), " ", "" ) == ;
		    StrTran( Upper( AllTrim( aSIX[nI][3] ) ), " ", "" )
			AutoGrLog( "Chave do índice alterado " + aSIX[nI][1] + "/" + aSIX[nI][2] + " - " + aSIX[nI][3] )
			lDelInd := .T. // Se for alteração precisa apagar o indice do banco
		EndIf
	EndIf

	RecLock( "SIX", !lAlt )
	For nJ := 1 To Len( aSIX[nI] )
		If FieldPos( aEstrut[nJ] ) > 0
			FieldPut( FieldPos( aEstrut[nJ] ), aSIX[nI][nJ] )
		EndIf
	Next nJ
	MsUnLock()

	dbCommit()

	If lDelInd
		TcInternal( 60, RetSqlName( aSIX[nI][1] ) + "|" + RetSqlName( aSIX[nI][1] ) + aSIX[nI][2] )
	EndIf

	oProcess:IncRegua2( "Atualizando índices ..." )

Next nI

AutoGrLog( CRLF + "Final da Atualização" + " SIX" + CRLF + Replicate( "-", 128 ) + CRLF )

Return NIL


