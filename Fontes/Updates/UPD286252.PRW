	'Nome Usr.Ini'															, ; //X3_TITSPA
	'Nome Usr.Ini'															, ; //X3_TITENG
	'Nome do Usuarioi Inicial'												, ; //X3_DESCRIC
	'Nome do Usuarioi Inicial'												, ; //X3_DESCSPA
