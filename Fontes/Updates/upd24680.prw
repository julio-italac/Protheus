	{ 'N'																	, .T. }, ; //X3_MODAL
	{ 'S'																	, .T. }} ) //X3_PYME

aAdd( aSX3, { ;
	{ 'SCP'																	, .T. }, ; //X3_ARQUIVO
	{ '02'																	, .T. }, ; //X3_ORDEM
	{ 'CP_NUM'																, .T. }, ; //X3_CAMPO
	{ 'C'																	, .T. }, ; //X3_TIPO
	{ 6																		, .T. }, ; //X3_TAMANHO
	{ 0																		, .T. }, ; //X3_DECIMAL
	{ 'Nr.S.A.'																, .T. }, ; //X3_TITULO
	{ 'Nro. S.A.'															, .T. }, ; //X3_TITSPA
	{ 'W.R.No.'																, .T. }, ; //X3_TITENG
	{ 'Numero da Solic.ao Armaz.'											, .T. }, ; //X3_DESCRIC
	{ 'Nro. Solicit. al Deposito'											, .T. }, ; //X3_DESCSPA
	{ 'Warehouse Request Nbr.'												, .T. }, ; //X3_DESCENG
	{ '@!'																	, .T. }, ; //X3_PICTURE
	{ ''																	, .T. }, ; //X3_VALID
	{ Chr(172) + Chr(157) + Chr(144) + Chr(129) + Chr(128) + ;
	Chr(139) + Chr(240) + Chr(192) + Chr(128) + Chr(128) + ;
	Chr(128) + Chr(128) + Chr(128) + Chr(131) + Chr(144)					, .T. }, ; //X3_USADO
	{ 'GetSXENum("SCP","CP_NUM")'											, .T. }, ; //X3_RELACAO
