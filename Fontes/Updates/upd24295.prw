	'ZW_ITEM'																, ; //CHAVE
	'ITEM'																	, ; //DESCRICAO
	''																		, ; //DESCSPA
	''																		, ; //DESCENG
	'U'																		, ; //PROPRI
	''																		, ; //F3
	''																		, ; //NICKNAME
	'N'																		} ) //SHOWPESQ

aAdd( aSIX, { ;
	'SZW'																	, ; //INDICE
	'C'																		, ; //ORDEM
	'ZW_NUMPED'																, ; //CHAVE
	'NUMPED'																, ; //DESCRICAO
	''																		, ; //DESCSPA
