	{ '35'																	, .T. }, ; //X3_ORDEM
	{ 'ZBF_DOCA'															, .T. }, ; //X3_CAMPO
	{ 'C'																	, .T. }, ; //X3_TIPO
	{ 30																	, .T. }, ; //X3_TAMANHO
